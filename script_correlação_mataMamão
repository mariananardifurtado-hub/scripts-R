salvar_grafico <- function(grafico, nome, largura = 11, altura = 7) {
  
  caminho_png <- file.path(pasta_saida, paste0(nome, ".png"))
  caminho_pdf <- file.path(pasta_saida, paste0(nome, ".pdf"))
  
  ggsave(
    filename = caminho_png,
    plot = grafico,
    width = largura,
    height = altura,
    dpi = 600,
    bg = "white"
  )
  
  ggsave(
    filename = caminho_pdf,
    plot = grafico,
    width = largura,
    height = altura,
    bg = "white"
  )
}

