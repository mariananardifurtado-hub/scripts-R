# ------------------------------------------------------------
# 4. Função de correlação
# ------------------------------------------------------------

calcular_cor <- function(base, geometria_i, classe_i, indice_i) {
  
  sub <- base %>%
    filter(geom_tipo == geometria_i) %>%
    select(all_of(c(classe_i, indice_i))) %>%
    drop_na()
  
  n <- nrow(sub)
  
  if (n < 3 || sd(sub[[classe_i]]) == 0 || sd(sub[[indice_i]]) == 0) {
    return(tibble(
      geometria = geometria_i,
      classe = classe_i,
      indice = indice_i,
      R = NA_real_,
      p_valor = NA_real_,
      n = n
    ))
  }
  
  teste <- cor.test(
    sub[[classe_i]],
    sub[[indice_i]],
    method = "pearson"
  )
  
  tibble(
    geometria = geometria_i,
    classe = classe_i,
    indice = indice_i,
    R = as.numeric(teste$estimate),
    p_valor = teste$p.value,
    n = n
  )
}

# ------------------------------------------------------------
# 5. Calcular todas as correlações
# ------------------------------------------------------------

geometrias <- unique(dados$geom_tipo)

correlacoes <- expand_grid(
  geometria = geometrias,
  classe = classes,
  indice = indices
) %>%
  pmap_dfr(~ calcular_cor(
    base = dados,
    geometria_i = ..1,
    classe_i = ..2,
    indice_i = ..3
  )) %>%
  mutate(
    abs_R = abs(R),
    classe_nome = recode(classe, !!!nomes_classes),
    significancia = case_when(
      is.na(p_valor) ~ "",
      p_valor < 0.001 ~ "***",
      p_valor < 0.01 ~ "**",
      p_valor < 0.05 ~ "*",
      TRUE ~ "ns"
    )
  )

write_csv(
